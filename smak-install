#!/bin/bash
# Smak Installer
#
# Usage: smak-install <prefix>
#
# Copies the smak source tree into <prefix>/share/smak/ and creates a
# symlink <prefix>/bin/smak → ../share/smak/smak. The smak bash wrapper
# follows its own symlink back to SCRIPT_DIR to locate Smak.pm and the
# sibling perl helpers, so the target of the symlink must be the real
# source tree — a plain copy of the wrapper into bin/ won't work.

set -e

installer=$0
case $installer in
    /*) ;; # already absolute
    *)  installer=$PWD/$installer ;;
esac
src_dir=$(dirname "$installer")

prefix=${1:-}
if [ -z "$prefix" ]; then
    echo "Usage: $(basename "$installer") <prefix>" >&2
    exit 1
fi
# Absolutize prefix so symlinks work regardless of CWD.
# smak's bash wrapper follows readlink to find SCRIPT_DIR, and its loop
# uses dirname on the raw link target — a relative target resolves against
# CWD, not the symlink's directory. Absolute symlinks avoid the problem.
case $prefix in
    /*) ;; # already absolute
    *)  prefix=$PWD/$prefix ;;
esac

mkdir -p "$prefix/bin" "$prefix/share"
# Stage the copy next to the target and swap it in, so a failure (e.g. the parent
# directory is root-owned and the old tree cannot be unlinked) never leaves
# $prefix/share/smak half-deleted. If the old directory itself cannot be removed,
# fall back to replacing its contents in place.
#
# rsync rather than cp -a: cp -a fails on Cygwin when it cannot replicate
# Windows ACLs/ownership. The trailing slash on the source matters: without it
# rsync would create $stage/smak/ instead of copying the tree to $stage.
# .git/, .claude/ and editor backups (*~) are never installed. The bundled
# cmake's doc/ and man/ (~53MB) are skipped unless SMAK_INSTALL_CMAKE_DOCS=1.
stage="$prefix/share/.smak.new.$$"
old="$prefix/share/.smak.old.$$"
# On any exit, drop the stage, and if the old tree was moved aside but the new
# one never landed, put the old one back.
cleanup() {
    rm -rf "$stage"
    if [ -e "$old" ] && [ ! -e "$prefix/share/smak" ]; then
        mv -T "$old" "$prefix/share/smak"
    fi
}
trap cleanup EXIT
rm -rf "$stage"
excludes=(--exclude='/.git/' --exclude='/.claude/' --exclude='*~')
if [ "${SMAK_INSTALL_CMAKE_DOCS:-0}" != 1 ]; then
    excludes+=(--exclude='/cmake-*/doc/' --exclude='/cmake-*/man/')
fi
if [ -d "$prefix/share/smak" ] && [ ! -w "$prefix/share" ]; then
    # The directory above is not ours to write in (root's, after a first
    # install as root) but the tree is: there is nowhere beside it to stage
    # a copy and no way to swap one in, so it is brought up to date in
    # place.  rsync puts each file in by renaming a finished copy over the
    # old one, so a smak started meanwhile never reads half a file.
    rsync -a --delete "${excludes[@]}" "$src_dir"/ "$prefix/share/smak"/
else
    rsync -a "${excludes[@]}" "$src_dir"/ "$stage"/
    if [ -e "$prefix/share/smak" ] && ! mv -T "$prefix/share/smak" "$old" 2>/dev/null; then
        find "$prefix/share/smak" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
        rsync -a "$stage"/ "$prefix/share/smak"/
    else
        mv -T "$stage" "$prefix/share/smak"
        rm -rf "$old"
    fi
fi
# A link that already points there is left alone: after a first install as
# root, $prefix/bin is root's and the links in it cannot be replaced, while
# $prefix/share/smak belongs to whoever keeps smak up to date.
link() {
    if [ "$(readlink "$2" 2>/dev/null)" = "$1" ]; then
        return 0
    fi
    ln -sf "$1" "$2"
}
link "$prefix/share/smak/smak" "$prefix/bin/smak"
link "$prefix/share/smak/cmake" "$prefix/bin/cmake"

echo "smak installed: $prefix/bin/smak -> $prefix/share/smak/smak"
echo "cmake wrapper:  $prefix/bin/cmake -> $prefix/share/smak/cmake"
